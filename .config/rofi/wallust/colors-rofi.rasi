 /* wallust template - colors-rofi */

* {
active-background: #8E8E8E;
active-foreground: #DEDEDE;
normal-background: #303030;
normal-foreground: #DEDEDE;
urgent-background: #A0A0A0;
urgent-foreground: #DEDEDE;

alternate-active-background: #7B7B7B;
alternate-active-foreground: #DEDEDE;
alternate-normal-background: #303030;
alternate-normal-foreground: #DEDEDE;
alternate-urgent-background: #303030;
alternate-urgent-foreground: #DEDEDE;

selected-active-background: #8E8E8E;
selected-active-foreground: #303030;
selected-normal-background: #8E8E8E;
selected-normal-foreground: #303030;
selected-urgent-background: #7B7B7B;
selected-urgent-foreground: #303030;

background-color: #303030;
background: rgba(0,0,0,0.7);
foreground: #DEDEDE;
border-color: #8E8E8E;

color0: #545454;
color1: #404040;
color2: #4E4E4E;
color3: #5C5C5C;
color4: #6A6A6A;
color5: #787878;
color6: #787878;
color7: #C7C7C7;
color8: #8B8B8B;
color9: #565656;
color10: #686868;
color11: #7B7B7B;
color12: #8E8E8E;
color13: #A0A0A0;
color14: #A0A0A0;
color15: #C7C7C7;


}

